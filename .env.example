# Copy to .env for local overrides. Do not put access keys, secrets, or session tokens here.
TRANSFERLENS_RUNTIME=local
AWS_REGION=us-east-1
# Set AWS_PROFILE only for local CLI use of the temporary hackathon session.
# Leave it empty on EC2 so the process uses the instance role.
AWS_PROFILE=
BEDROCK_MODEL_ID=us.amazon.nova-pro-v1:0
TRANSFERLENS_BUCKET=
TRANSFERLENS_TABLE=
TRANSFERLENS_LOG_GROUP=
TRANSFERLENS_DATA_DIR=.local-data
TRANSFERLENS_EXPECTED_ACCOUNT_ID=884025082158
